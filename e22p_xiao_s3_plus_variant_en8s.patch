diff --git a/src/platform/extra_variants/e22p_xiao_s3_plus/variant.cpp b/src/platform/extra_variants/e22p_xiao_s3_plus/variant.cpp
new file mode 100644
index 0000000..2fd9993
--- /dev/null
+++ b/src/platform/extra_variants/e22p_xiao_s3_plus/variant.cpp
@@ -0,0 +1,15 @@
+#include "configuration.h"
+
+#if defined(E22P_XIAO_S3_PLUS)
+
+// E22P-868M30S: EN = LNA_EN + RF switch EN.
+// Przed startem trzyma go LOW rezystor 10k do GND.
+void lateInitVariant()
+{
+    pinMode(E22P_EN, OUTPUT);
+    digitalWrite(E22P_EN, LOW);
+    delay(8000);                   // okno jak w restarterze Bikemana
+    digitalWrite(E22P_EN, HIGH);   // EN stale w stanie wysokim
+}
+
+#endif
